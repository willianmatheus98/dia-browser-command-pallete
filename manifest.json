{
  "manifest_version": 3,
  "name": "Dia Command Palette",
  "version": "0.1.0",
  "description": "Arc-style command palette: switch tabs, search history, bookmarks and the web, or start a new chat.",
  "permissions": ["tabs", "history", "bookmarks", "storage", "search", "favicon", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/app*"],
      "js": ["src/content/gemini-prefill.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/palette/palette.html", "src/palette/palette.css", "src/palette/palette.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Open command palette"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Open the command palette"
    }
  }
}
